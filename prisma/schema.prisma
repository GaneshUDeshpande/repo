generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ActivityType {
  STREAK
  COMPLETION
  DISCOVERY
  PROFILE
  QUIZ
  CUSTOM
}

model User {
  id            String    @id @default(cuid())
  displayName   String
  email         String?   @unique
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  settings      UserSettings?
  desktop       DesktopConfiguration?
  progress      UserProgress[]
  collectibles  UserCollectible[]
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  preferredEraId     String?
  theme              String   @default("classic")
  accessibilityMode  String   @default("standard")
  soundEnabled       Boolean  @default(true)
  animationEnabled   Boolean  @default(true)
  wallpaper          String   @default("classic-grid")
  language           String   @default("en")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredEra       Era?     @relation("PreferredEra", fields: [preferredEraId], references: [id])
}

model Era {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  sortOrder   Int
  active      Boolean  @default(true)
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
  collectibles Collectible[]
  content      ContentItem[]
  activities   ActivityDefinition[]
  progress     UserProgress[]
  preferredUsers UserSettings[] @relation("PreferredEra")
}

model Application {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  category    String
  eraId       String
  icon        String?
  config      String   @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  era         Era      @relation(fields: [eraId], references: [id], onDelete: Cascade)
  activities  ActivityDefinition[]
  content     ContentItem[]
}

model Collectible {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  description         String
  category            String
  eraId               String?
  rarity              String
  assetReference      String?
  unlockRequirements  String   @default("{}")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  era                 Era?     @relation(fields: [eraId], references: [id], onDelete: SetNull)
  owners              UserCollectible[]
}

model UserCollectible {
  id              String   @id @default(cuid())
  userId          String
  collectibleId   String
  unlockedAt      DateTime @default(now())
  acquisitionSource String
  metadata        String   @default("{}")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectible     Collectible @relation(fields: [collectibleId], references: [id], onDelete: Cascade)

  @@unique([userId, collectibleId])
}

model DesktopConfiguration {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  wallpaper              String   @default("classic-grid")
  theme                  String   @default("classic")
  layout                 String   @default("[]")
  iconArrangement        String   @default("[]")
  appPreferences         String   @default("{}")
  configurationVersion   Int      @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id                  String   @id @default(cuid())
  userId              String
  eraId               String
  progress            String   @default("{}")
  completedActivities String   @default("[]")
  lastActivityAt      DateTime?
  metadata            String   @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  era                 Era      @relation(fields: [eraId], references: [id], onDelete: Cascade)

  @@unique([userId, eraId])
}

model ActivityDefinition {
  id                   String       @id @default(cuid())
  slug                 String       @unique
  title                String
  description          String
  activityType         ActivityType
  eraId                String?
  applicationId        String?
  requirements         String       @default("{}")
  collectibleUnlocks   String       @default("[]")
  active               Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  era                  Era?         @relation(fields: [eraId], references: [id], onDelete: SetNull)
  application          Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
}

model ContentItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String
  contentType String
  eraId       String?
  applicationId String?
  tags        String   @default("[]")
  assetRefs   String   @default("[]")
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  era         Era?      @relation(fields: [eraId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
}
